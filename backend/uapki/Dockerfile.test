FROM uapki:latest

# Install Python and dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip3 install --no-cache-dir \
    httpx \
    cryptography

# Copy test script
COPY test_uapki_docker.py /app/test_uapki_docker.py

# Copy JKS file (already copied to uapki directory)
COPY test_key.jks /app/test_key.jks

WORKDIR /app

CMD ["python3", "test_uapki_docker.py"]
